{
  "sourceLanguage": "en",
  "strings": {
    "\n\nCodex will send the conversation ID, turn ID, and final response, permission request, or questions and options to local AIBox. This program only receives notifications. It does not answer questions, approve or deny permissions, or request continuation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nCodex will send the conversation ID, turn ID, and final response, permission request, or questions and options to local AIBox. This program only receives notifications. It does not answer questions, approve or deny permissions, or request continuation."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nCodex 將把對話 ID、輪次 ID，以及最後回覆、授權請求或問題與選項傳給本機 AIBox。此程式只接收通知，不代答問題、不同意或拒絕授權，不要求續跑。"
          }
        }
      }
    },
    " · %@ confirmed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · %@ confirmed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " · %@已確認"
          }
        }
      }
    },
    "%.1f s": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f s"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f 秒"
          }
        }
      }
    },
    "%@\n%@\nConversation: %@\nClick to open this conversation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n%@\nConversation: %@\nClick to open this conversation"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n%@\n對話：%@\n點擊開啟此對話"
          }
        }
      }
    },
    "%@ cleared its pairing, but macOS still has the old pairing. In System Settings → Bluetooth, choose Forget This Device for AIBox, then return, click Search Again and confirm the light color.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cleared its pairing, but macOS still has the old pairing. In System Settings → Bluetooth, choose Forget This Device for AIBox, then return, click Search Again and confirm the light color."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已清除配對，但 macOS 仍保留舊配對。請在「系統設定 → 藍牙」對 AIBox 選擇「忘記此裝置設定」，再回來按「重新搜尋」並確認燈色。"
          }
        }
      }
    },
