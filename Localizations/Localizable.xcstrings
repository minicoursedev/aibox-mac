    "Choose a box, observe its flashing color, then select the color you see. After confirmation, this Mac will remember and reconnect only to that box.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a box, observe its flashing color, then select the color you see. After confirmation, this Mac will remember and reconnect only to that box."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選一台 box，觀察它閃爍的顏色，再選出你看到的顏色。確認後，這台 Mac 會記住並只連回這台 box。"
          }
        }
      }
    },
    "Choose motion or sound to open notifications, and adjust the sound threshold live.": {
